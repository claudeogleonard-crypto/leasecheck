# Copy to .env for local dev (`netlify dev` loads it). In production, set these
# in Netlify: Site configuration > Environment variables (scope: Functions).

# Required: Claude API key, used only inside Netlify Functions.
ANTHROPIC_API_KEY=sk-ant-...

# Required for the staff dashboard (shared password sent as a header).
STAFF_PASSWORD=change-me

# Optional: secret for internal function-to-function calls.
# If unset it is derived from ANTHROPIC_API_KEY.
INTERNAL_SECRET=

# Optional notifications. Without these, notifications are still recorded and
# shown on the staff dashboard, just not delivered externally.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=LeaseCheck <leasecheck@example.edu>
STAFF_NOTIFY_EMAIL=offcampus-housing@example.edu
# Slack/Teams-compatible incoming webhook (receives {"text": "..."}).
NOTIFY_WEBHOOK_URL=
